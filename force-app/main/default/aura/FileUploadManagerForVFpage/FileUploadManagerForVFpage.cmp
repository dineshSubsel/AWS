<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId">
    <aura:attribute name="isClassic" type="Boolean" default="false" />

    <aura:handler name="init" value="{!this}" action="{!c.checkUITheme}" />

    <aura:if isTrue="{!v.isClassic}">
        <!-- Display the Visualforce page when in Classic -->
        <iframe src="{!'/apex/FileManager?id=' + v.recordId}" width="100%" height="400px" frameborder="0" />
    </aura:if>
</aura:component>